---
import PrimaryButton from "@/components/PrimaryButton.astro";
import { cn } from "@/lib/cn";
import { layers } from "@/lib/layers";
import { DOCS_URL, GITHUB_URL, SIGN_IN_URL } from "@/lib/site";
---

<header
  id="site-header"
  class={cn("site-header sticky top-0 border-b border-transparent bg-transparent pt-[env(safe-area-inset-top)]")}
  style={`z-index: ${layers.header}`}
>
  <div
    class="mx-auto flex h-[4.5rem] max-w-7xl items-center justify-between gap-6 px-4 md:px-6"
  >
    <a
      href="/"
      class="font-mono text-base tracking-tight text-foreground no-underline hover:no-underline"
    >
      watchdog
    </a>

    <nav class="flex shrink-0 items-center gap-6 md:gap-8">
      <a
        href="#how-it-works"
        class="hidden text-sm text-muted-foreground no-underline hover:text-foreground hover:no-underline md:inline"
      >
        How it works
      </a>
      <a
        href={GITHUB_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden text-sm text-muted-foreground no-underline hover:text-foreground hover:no-underline sm:inline"
        aria-label="Watchdog on GitHub"
      >
        GitHub
      </a>
      <a
        href={SIGN_IN_URL}
        class="hidden text-sm text-muted-foreground no-underline hover:text-foreground hover:no-underline sm:inline"
      >
        Sign in
      </a>
      <PrimaryButton href={DOCS_URL} external>Get started</PrimaryButton>
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    const header = document.querySelector("#site-header");
    if (!header) return;

    const sync = () => {
      header.toggleAttribute("data-scrolled", window.scrollY > 8);
    };

    sync();
    window.addEventListener("scroll", sync, { passive: true });
  })();
</script>

<style>
  .site-header[data-scrolled] {
    border-color: var(--border);
    background-color: color-mix(in oklab, var(--background) 96%, transparent);
  }
</style>
