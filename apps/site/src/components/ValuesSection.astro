---
const pains = [
  {
    title: "Summaries treated as fact",
    body: "With no evidence chain behind them, conclusions spread faster than the material that supports them.",
  },
  {
    title: "The chat log becomes the case file",
    body: "Separate copies diverge. Catching up means reading scrollback instead of reading the case.",
  },
  {
    title: "Identity links on coincidence",
    body: "A matching handle, a shared mailbox, or a coincidence isn't enough when someone asks how you know.",
  },
  {
    title: "More collection, less clarity",
    body: "A seed that fans out into hundreds of job runs produces more data, not more clarity.",
  },
];
---

<section class="border-b border-border py-24 md:py-32">
  <div class="mx-auto max-w-7xl px-4 md:px-6">
    <h2 class="max-w-2xl text-3xl font-semibold text-balance text-foreground md:text-5xl">
      Built for cases you may have to defend
    </h2>
    <p class="mt-5 max-w-lg text-lg leading-relaxed text-muted-foreground">
      Small-team OSINT usually runs on general-purpose tools until the case gets big enough to hit
      the same failures every time.
    </p>

    <div class="mt-14 grid gap-px bg-border md:grid-cols-2">
      {
        pains.map((pain) => (
          <div class="bg-background px-6 py-8">
            <h3 class="text-xl font-medium text-foreground">{pain.title}</h3>
            <p class="mt-3 text-base leading-relaxed text-muted-foreground">{pain.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
