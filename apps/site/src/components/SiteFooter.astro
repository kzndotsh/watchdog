---
import { DOCS_URL, GITHUB_URL, SIGN_IN_URL } from "@/lib/site";
---

<footer class="border-t border-border py-12 md:py-16">
  <div class="mx-auto max-w-7xl px-4 md:px-6">
    <nav
      class="flex flex-wrap gap-x-6 gap-y-3 text-sm"
      aria-label="Footer"
    >
      <a href={SIGN_IN_URL} class="text-foreground no-underline hover:underline">
        Sign in
      </a>
      <a
        href={DOCS_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="text-muted-foreground no-underline hover:text-foreground hover:underline"
      >
        Documentation
      </a>
      <a
        href={GITHUB_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="text-muted-foreground no-underline hover:text-foreground hover:underline"
      >
        GitHub
      </a>
    </nav>

    <p class="mt-10 font-mono text-sm text-muted-foreground">
      An OSINT case platform where machines collect and humans decide.
    </p>
  </div>
</footer>
