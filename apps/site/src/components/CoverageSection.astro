---
const categories = [
  { name: "network", count: 25, examples: "DNS, WHOIS/RDAP, certificates, Shodan" },
  { name: "threat", count: 17, examples: "VirusTotal, AbuseIPDB, GreyNoise, OTX" },
  { name: "identity", count: 6, examples: "GitHub, Keybase, Gravatar, PGP" },
  { name: "breach", count: 4, examples: "HIBP, Dehashed, Snusbase" },
  { name: "archive", count: 4, examples: "Wayback, Common Crawl" },
  { name: "evidence", count: 4, examples: "Harvest, extraction, file and .eml" },
  { name: "web", count: 3, examples: "Unshorten, page enrichment" },
];
---

<section class="border-b border-border py-24 md:py-32">
  <div class="mx-auto max-w-7xl px-4 md:px-6">
    <p class="font-mono text-sm text-muted-foreground">60+ integrations</p>
    <h2 class="mt-3 max-w-2xl text-3xl font-semibold text-balance text-foreground md:text-5xl">
      The lookups you already run by hand, wired into one workflow.
    </h2>
    <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted-foreground">
      Each one comes back as a claim with its evidence attached, checked the same way as everything
      else in the case.
    </p>

    <div class="mt-14 grid gap-px bg-border sm:grid-cols-2 lg:grid-cols-4">
      {
        categories.map((category) => (
          <div class="bg-background px-5 py-6">
            <p class="font-mono text-sm text-foreground">{category.name}</p>
            <p class="mt-3 font-mono text-3xl text-foreground">{category.count}</p>
            <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{category.examples}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
