{
  "name": "@watchdog/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "node scripts/build.mjs",
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.test.json --incremental --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.2",
    "@watchdog/core": "workspace:*",
    "@watchdog/env": "workspace:*",
    "@watchdog/log": "workspace:*",
    "@watchdog/schemas": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
