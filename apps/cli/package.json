{
  "name": "@watchdog/cli",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "bin": {
    "wd": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#client": "./client/src/index.ts"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.test.json --incremental --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo",
    "prepare": "pnpm run client:generate && node ./scripts/build.mjs",
    "prepack": "node ./scripts/build.mjs",
    "pack:smoke": "node ./scripts/pack-smoke.mjs",
    "client:generate": "pnpm --filter @watchdog/server api:export-contract"
  },
  "dependencies": {
    "@orpc/client": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/openapi-client": "^1.16.4",
    "@watchdog/domain": "workspace:*",
    "citty": "^0.2.2",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
