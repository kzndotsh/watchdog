{
  "name": "@watchdog/cli",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "wd": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "prepare": "node ./scripts/build.mjs",
    "prepack": "node ./scripts/build.mjs",
    "pack:smoke": "node ./scripts/pack-smoke.mjs"
  },
  "dependencies": {
    "@watchdog/client": "workspace:*",
    "@watchdog/schemas": "workspace:*",
    "citty": "^0.2.2",
    "dotenv": "^17.4.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
