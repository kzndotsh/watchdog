  "scripts": {
    "core:build:rekey": "cd core && node scripts/build-rekey.mjs",
    "core:vault-rekey": "cd core && tsx src/vault-rekey-cli.ts",
    "api:export-contract": "cd api && tsx scripts/export-contract.ts",
    "db:generate": "cd db && drizzle-kit generate",
    "db:migrate": "cd db && tsx --env-file-if-exists=../../../.env src/migrate-cli.ts",
    "db:build:migrate": "cd db && node scripts/build-migrate.mjs",
    "db:studio": "cd db && drizzle-kit studio",
    "db:seed:demo": "cd db && tsx scripts/demo-seed/run.ts",
    "auth:bootstrap-admin": "cd auth && tsx src/bootstrap-admin-cli.ts",
    "auth:build:bootstrap": "cd auth && node scripts/build-bootstrap.mjs",
    "worker:dev": "tsx watch worker/src/main.ts",
    "worker:build": "cd worker && node scripts/build.mjs",
    "worker:start": "tsx worker/src/main.ts",
    "typecheck": "tsc -p tsconfig.test.json --incremental --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1171.0",
