{
  "name": "watchdog",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev:web": "pnpm --filter @watchdog/web dev",
    "dev:site": "pnpm --filter @watchdog/site dev",
    "dev:worker": "pnpm --filter @watchdog/worker dev",
    "dev:cli": "pnpm --filter @watchdog/cli dev",
    "build": "pnpm --filter @watchdog/web build",
    "build:site": "pnpm --filter @watchdog/site build",
    "build:cli": "pnpm --filter @watchdog/cli build",
    "check": "ultracite check --disable-nested-config",
    "fix": "ultracite fix --disable-nested-config",
    "doctor:react": "react-doctor apps/web --verbose -y --blocking none",
    "doctor:react:diff": "react-doctor apps/web --verbose --scope changed --base main -y --blocking none",
    "typecheck": "pnpm --filter . run --parallel \"/^(typecheck:|check:test-coverage-guard$)/\"",
    "typecheck:packages": "pnpm -r --no-sort --workspace-concurrency=8 typecheck",
    "typecheck:scripts": "tsc -p scripts/tsconfig.test.json --incremental --tsBuildInfoFile node_modules/.cache/typecheck-scripts.tsbuildinfo",
    "typecheck:e2e": "tsc -p e2e/tsconfig.test.json --incremental --tsBuildInfoFile node_modules/.cache/typecheck-e2e.tsbuildinfo",
    "check:test-coverage-guard": "node ./scripts/check-test-coverage-guard.mjs",
    "test": "vitest run --project unit --project web-unit --project e2e-parser --project property --project gate",
    "test:gate": "vitest run --project gate",
    "test:unit": "vitest run --project unit --project web-unit",
    "test:e2e-parser": "vitest run --project e2e-parser",
    "test:property": "vitest run --project property",
    "test:component": "vitest run --project component --project component-compiled",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --project unit --project web-unit --project property --project component --project component-compiled --project e2e-parser --coverage",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep \"@smoke|@custody\"",
    "test:e2e:journey": "playwright test --grep @journey",
    "test-db": "bash scripts/ensure-test-db.sh",
    "knip": "knip --cache --no-config-hints",
    "generate:caps": "pnpm --filter @watchdog/caps generate",
    "generate:client": "pnpm --filter @watchdog/client generate",
    "generate:notices": "node ./scripts/generate-notices.mjs",
    "generate:env": "node ./scripts/generate-env-docs.mjs",
    "check:env": "node ./scripts/generate-env-docs.mjs --check",
    "check:notices": "node ./scripts/generate-notices.mjs --check",
    "check:licenses": "node ./scripts/check-licenses.mjs",
    "generate-routes": "pnpm --filter @watchdog/web generate-routes",
    "db:generate": "pnpm --filter @watchdog/db generate",
    "db:migrate": "pnpm --filter @watchdog/db migrate",
    "db:studio": "pnpm --filter @watchdog/db studio",
    "seed:demo": "pnpm --filter @watchdog/db seed:demo",
    "vault:rekey": "pnpm --filter @watchdog/core vault-rekey",
    "admin:bootstrap": "pnpm --filter @watchdog/auth bootstrap-admin",
    "check:tagged-errors": "node ./scripts/check-tagged-errors.mjs",
    "check:tagged-errors:strict": "node ./scripts/check-tagged-errors.mjs --strict",
    "check:workspace-reexports": "node ./scripts/check-workspace-reexports.mjs",
    "check:agents:strict": "node ./scripts/check-agents.mjs --strict",
    "check:docs": "node ./scripts/check-docs.mjs",
    "check:design-tokens": "node ./scripts/check-design-tokens.mjs",
    "lint:design": "node ./scripts/lint-design.mjs",
    "changed": "node ./scripts/changed-packages.mjs",
    "check:size": "node ./scripts/check-size-budget.mjs",
    "check:bundle": "node ./scripts/check-bundle-budget.mjs",
    "check:docs:strict": "node ./scripts/check-docs.mjs --strict --fail-length",
    "check:docs-affected:strict": "node ./scripts/check-docs-affected.mjs",
    "validate:agents": "node ./scripts/validate-agents.mjs",
    "desloppify:bootstrap": "bash scripts/desloppify-bootstrap.sh",
    "desloppify:scan": "bash scripts/desloppify-bootstrap.sh && PYTHONPATH= desloppify --lang typescript scan --path .",
    "desloppify:scan:ci": "bash scripts/desloppify-bootstrap.sh && PYTHONPATH= desloppify --lang typescript scan --path . --profile ci --no-badge",
    "desloppify:status": "desloppify status",
    "desloppify:next": "desloppify next",
    "prepare": "effect-tsgo patch --oxlint",
    "check:action-pins": "node ./scripts/check-action-pins.mjs",
    "check:workspace": "sherif --fail-on-warnings && node ./scripts/check-catalog.mjs",
    "check:migrations": "node ./scripts/check-migrations.mjs",
    "check:boundaries": "node ./scripts/check-boundaries.mjs",
    "check:codeowners": "node ./scripts/check-codeowners.mjs",
    "check:vendor": "node ./scripts/ui-vendor.mjs check",
    "ui:sync": "node ./scripts/ui-vendor.mjs sync",
    "ui:add": "node ./scripts/ui-vendor.mjs add"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@effect/tsgo": "0.51.1",
    "@effect/vitest": "4.0.2",
    "@google/design.md": "0.4.0",
    "@playwright/test": "^1.64.0",
    "@rolldown/plugin-babel": "catalog:",
    "@shadcn/lint": "0.2.0",
    "@types/node": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "^5.0.5",
    "@watchdog/cli": "workspace:*",
    "@watchdog/test-db": "workspace:*",
    "@watchdog/test-kit": "workspace:*",
    "babel-plugin-react-compiler": "catalog:",
    "cn": "catalog:",
    "effect": "catalog:",
    "happy-dom": "^21.0.3",
    "jsdom": "^30.1.2",
    "knip": "^6.41.0",
    "oxfmt": "^0.72.0",
    "oxlint": "catalog:",
    "oxlint-plugin-react-doctor": "^0.9.17",
    "oxlint-tsgolint": "7.0.2003",
    "react-doctor": "^0.9.17",
    "sherif": "1.13.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "ultracite": "7.12.4",
    "undici": "catalog:",
    "vitest": "catalog:",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.9.0"
}
