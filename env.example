# ============================================================
# Watchdog Platform — Environment Variables
# Copy to .env and fill in real values.
# Validated by @watchdog/env/server (T3 Env + Zod).
# Cap API keys live in Settings vault — not here.
# ============================================================

# ---- Database ----
DATABASE_URL=postgresql://watchdog_app:watchdog@127.0.0.1:5432/watchdog
# Superuser URL for pnpm db:migrate (falls back to DATABASE_URL if unset)
DATABASE_URL_MIGRATE=postgresql://postgres:postgres@127.0.0.1:5432/watchdog

# ---- Better Auth (TanStack Start) ----
# Generate ≥32 chars: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32
BETTER_AUTH_URL=http://127.0.0.1:3000
# Set to 1 only when bootstrapping the first solo account, then 0
BETTER_AUTH_ALLOW_SIGNUP=0
# Optional comma-separated extra trusted origins
# BETTER_AUTH_TRUSTED_ORIGINS=

# Optional SMTP for organization invitations (copy-link still works without it)
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=watchdog@localhost

# ---- Object storage (MinIO / S3) ----
S3_ENDPOINT=http://127.0.0.1:9100
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=watchdog-evidence
S3_REGION=us-east-1

# ---- Vault (Cap credentials at rest) ----
# Prefer 32-byte base64 or 64-char hex:
#   openssl rand -base64 32
#   openssl rand -hex 32
WD_MASTER_VAULT_KEY=

# ---- Case Export shadow (optional) ----
# Default: <repo>/export (gitignored)
# WD_EXPORT_DIR=

# ---- CLI (`wd`) — validated by @watchdog/cli loadCliEnv() only ----
WD_API_URL=http://localhost:3000/api/v1
# Create in Settings → API Keys (required for `wd`; lazy — `--help` works without it)
# WD_API_KEY=
# Optional agent UX (read by CLI process.env, not T3 Env):
# WD_CLI_HELP=0   # disable help[] hints on JSON output
# WD_CLI_DEBUG=1  # print stacks on stderr

# ---- Runtime ----
# NODE_ENV=development

# ---- Dev / CI only ----
# SKIP_ENV_VALIDATION=1
