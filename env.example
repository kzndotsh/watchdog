# ============================================================
# Watchdog platform: environment variables (development)
# GENERATED by `pnpm generate:env` from packages/env/src. Do not edit:
# change the field's .meta() and regenerate (`pnpm check:env` fails when stale).
# `just env` copies this to .env and fills the secrets; Cap API keys live in the
# Settings vault, not here. Every variable, with defaults and which service reads it:
# docs/reference/platform/configuration.md. Production: env.production.example.
# ============================================================

# ---- Database ----
# Postgres connection URL of the application role (watchdog_app): data privileges only,
# no DDL, no ownership. The web app and worker connect with it. The password in it is a
# secret.
# Required, secret.
DATABASE_URL=
# Connection URL of the owner role, which owns the schema: migrations, the first-admin
# command and vault key rotation run as it. Falls back to DATABASE_URL, which then must
# own the schema (a single-role setup without the privilege split).
# Optional, secret.
# DATABASE_URL_MIGRATE=

# ---- Authentication ----
# Signs sessions and cookies. At least 32 characters; known placeholder values are
# refused. Changing it signs everyone out.
# Required, secret.
BETTER_AUTH_SECRET=
# The exact URL users type in the browser, with scheme and no trailing slash. Also the
# CORS origin of the object-store bucket.
# Optional, default http://127.0.0.1:3000.
BETTER_AUTH_URL=http://127.0.0.1:3000
# Open public registration (anyone can sign up and create organizations). Leave 0 and
# create the first admin with the bootstrap command; restart web after changing it.
# Optional, default false.
BETTER_AUTH_ALLOW_SIGNUP=0
# Extra origins that may call the app, comma-separated (parsed to a list).
# Optional, default empty.
# BETTER_AUTH_TRUSTED_ORIGINS=

# ---- Email (SMTP) ----
# SMTP server for invitation mail. Mail is sent only when both SMTP_HOST and SMTP_FROM
# are set.
# Optional.
# SMTP_HOST=
# SMTP port. Unset sends on 587 (STARTTLS); 465 uses implicit TLS.
# Optional.
# SMTP_PORT=
# SMTP username, when the server requires authentication.
# Optional.
# SMTP_USER=
# SMTP password, when the server requires authentication.
# Optional, secret.
# SMTP_PASS=
# Sender address of invitation mail (an email address).
# Optional.
# SMTP_FROM=

# ---- Object storage ----
# S3-compatible endpoint the server reads and writes Evidence through (SeaweedFS
# locally). Browsers also upload to it with presigned requests unless S3_PUBLIC_URL is
# set.
# Required.
S3_ENDPOINT=http://127.0.0.1:9100
# URL browsers use for presigned Evidence uploads and downloads, when it differs from
# S3_ENDPOINT (a public HTTPS name for an internal store). Unset presigns against
# S3_ENDPOINT.
# Optional.
# S3_PUBLIC_URL=
# Access key id of the object store.
# Required.
S3_ACCESS_KEY=watchdog
# Secret key of the object store. The development default is refused when NODE_ENV is
# production.
# Required, secret.
S3_SECRET_KEY=
# Evidence bucket name.
# Required.
S3_BUCKET=watchdog-evidence
# Region used to sign object-store requests.
# Optional, default us-east-1.
# S3_REGION=

# ---- Vault ----
# Master key that encrypts stored Cap credentials. At least 32 characters (base64 or hex
# of 32 bytes recommended); known placeholders are refused. Back it up: without it
# stored credentials cannot be read, and changing it makes them unreadable unless you
# rotate it with just vault-rekey (node vault-rekey.mjs in the container).
# Required, secret.
WD_MASTER_VAULT_KEY=

# ---- Case Export ----
# Folder of the Case Export shadow. Unset uses the export folder in the repository root
# (the image uses /data/export).
# Optional.
# WD_EXPORT_DIR=
# Largest Case export zip, in megabytes of Evidence, that the web app streams straight
# to the download. A bigger export runs as a Job on the worker, is stored in object
# storage and shows up in Recent activity when it is ready (the Job's Case page has the
# download link).
# Optional, default 100.
WD_EXPORT_INLINE_MAX_MB=100
# Hours the download link of a large Case export works after the archive is stored (the
# Job finishing). After that the link answers 410 and the worker deletes the stored
# archive.
# Optional, default 24.
WD_EXPORT_LINK_TTL_HOURS=24
# How many Evidence files a Case export reads from object storage at once, and how many
# Graph entities it renders at once. Lower it on a small database or store; memory use
# is bounded by this times one read buffer.
# Optional, default 4.
WD_EXPORT_CONCURRENCY=4

# ---- Worker lanes ----
# How many quick lookups run at once (Caps that make one provider call, like DNS, WHOIS,
# IP and URL lookups). Per worker process; a second worker adds its own slots. Each
# running Job can hold a database connection, and the worker's pool has 10: the worker
# refuses to start when the three lane settings sum to more than 8 (the pool minus 2
# kept for its own loops). Applies to the quick lane only.
# Optional, default 4.
WD_WORKER_QUICK_CONCURRENCY=4
# How many heavy Jobs run at once (Caps that parse stored Evidence, Caps flagged slow,
# and large Case exports). Per worker process; a second worker adds its own slots. Each
# running Job can hold a database connection, and the worker's pool has 10: the worker
# refuses to start when the three lane settings sum to more than 8 (the pool minus 2
# kept for its own loops). Applies to the heavy lane only.
# Optional, default 2.
WD_WORKER_HEAVY_CONCURRENCY=2
# How many action Jobs run at once (Caps that change something at a provider, like
# submitting a URL to an archive). An action Job is never run twice: if its worker dies
# mid-run, reconcile fails it and you start it again. Per worker process; a second
# worker adds its own slots. Each running Job can hold a database connection, and the
# worker's pool has 10: the worker refuses to start when the three lane settings sum to
# more than 8 (the pool minus 2 kept for its own loops). Applies to the act lane only.
# Optional, default 2.
WD_WORKER_ACT_CONCURRENCY=2

# ---- Job logs ----
# Most log lines one Job keeps. Past it the Job's log ends with a truncation marker and
# later lines are dropped (the Job still runs). Lines are also cut to 1000 characters.
# Optional, default 1000.
WD_JOB_LOG_MAX_LINES=1000
# Most kilobytes of log text one Job keeps, with the same truncation marker as the line
# limit. Each save rewrites the Job's log, so a high value costs database writes on a
# chatty Cap.
# Optional, default 128.
WD_JOB_LOG_MAX_KB=128
# How often, in milliseconds, a running Job's new log lines are saved and pushed to open
# Job pages. A Job saves at most once per interval however many lines it logs, and once
# more when it ends.
# Optional, default 1000.
WD_JOB_LOG_FLUSH_MS=1000

# ---- Case retention ----
# Days a deleted Case stays restorable (owners and admins can restore it from Deleted
# Cases). After that the worker purges it for good: the Case, its Graph and history and
# its files are erased and only the deletion record remains. Backups keep a deleted Case
# until they age out.
# Optional, default 30.
WD_CASE_RETENTION_DAYS=30

# ---- Breach Caps ----
# Enable the breach Caps (HIBP, Hudson Rock, DeHashed, Snusbase), which query breach and
# leak corpora about people; DeHashed and Snusbase can return recovered plaintext
# credentials. Off by default: while it is off none of them can be queued or run, the
# web app shows them disabled and Playbooks that include them cannot start. Turning it
# on makes you responsible for a lawful basis for the lookups and for each provider's
# terms; see docs/reference/platform/cap-register.md. Restart web and worker after
# changing it.
# Optional, default false.
WD_ENABLE_BREACH_CAPS=0

# ---- Outbound egress ----
# http(s) proxy for every Cap and tool request; credentials may be embedded, so treat it
# as a secret. Unset connects directly. See docs/reference/platform/caps-boundary.md.
# Optional, secret.
# WD_EGRESS_PROXY=

# ---- Error reporting ----
# Send server, worker and browser errors to a tracker that speaks the Sentry protocol
# (Sentry, GlitchTip, Bugsink): its DSN, https://<key>@host/<project>. Unset (the
# default) sends nothing anywhere; a value that is not a valid DSN leaves reporting off
# and logs one warning at start. Secrets, request bodies, Evidence content and emails
# are scrubbed before an error leaves. See docs/how-to/self-host.md.
# Optional, secret.
# WD_ERROR_REPORTING_DSN=
# Release or version label attached to error reports and exported logs (for example
# 1.4.0 or a commit SHA), so a report names the build it came from. Unset omits it.
# Optional.
# WD_RELEASE=

# ---- Log export (OTLP) ----
# Export logs from the web app and the worker over OTLP/HTTP: the base URL of an
# OpenTelemetry Collector, Datadog, Grafana Cloud, Honeycomb or SigNoz (Watchdog adds
# /v1/logs). Unset (the default) sends nothing anywhere; a value that is not an http(s)
# URL leaves export off and logs one warning at start. Every record is scrubbed first.
# May embed credentials, so treat it as a secret. See docs/how-to/self-host.md.
# Optional, secret.
# WD_OTLP_ENDPOINT=
# Headers sent with every OTLP request, as comma-separated name=value pairs (for example
# x-honeycomb-team=KEY or DD-API-KEY=KEY). Usually the API key. Malformed pairs leave
# export off with one warning. Ignored while WD_OTLP_ENDPOINT is unset.
# Optional, secret.
# WD_OTLP_HEADERS=
# Extra OTLP resource attributes as comma-separated key=value pairs (for example
# deployment.region=eu,team=osint). service.name, service.version (WD_RELEASE) and
# deployment.environment are set for you. Malformed pairs leave export off with one
# warning.
# Optional.
# WD_OTLP_RESOURCE_ATTRIBUTES=

# ---- Runtime ----
# Runtime mode. The container images set production; production also refuses the
# development object-store secret.
# Optional, default development.
# NODE_ENV=

# ---- Container and process ----
# 1 skips environment validation (lint and image builds without secrets). Never set it
# in a deployment.
# Optional.
# SKIP_ENV_VALIDATION=

# ---- CLI (wd) ----
# Base URL of the Watchdog API the wd CLI calls.
# Optional, default http://localhost:3000/api/v1.
WD_API_URL=http://localhost:3000/api/v1
# API key the wd CLI sends (create one in Settings, API Keys). Read lazily: --help works
# without it.
# Required, secret.
# WD_API_KEY=
# 0 turns off the help[] hints on the CLI's JSON output.
# Optional, default on.
# WD_CLI_HELP=
# 1 prints stack traces on stderr.
# Optional, default off.
# WD_CLI_DEBUG=

# ---- Marketing site ----
# URL of the app the marketing site links to (Astro build time only).
# Optional, default http://127.0.0.1:3000.
# PUBLIC_APP_URL=
