{
  "extends": "./tsconfig.base.json",
  "files": [],
  // Type context for linting root config files by path (the pre-commit hook); never emitted.
  "include": ["*.config.ts"],
  "compilerOptions": {
    "paths": {
      "@/*": ["./apps/web/src/*"],

      "@watchdog/caps/ai": ["./packages/caps/ai/src/index.ts"],
      "@watchdog/caps/ai/*": ["./packages/caps/ai/src/*"],

      "@watchdog/server/api": ["./packages/server/api/src/index.ts"],
      "@watchdog/server/api/*": ["./packages/server/api/src/*"],

      "@watchdog/server/auth/*": ["./packages/server/auth/src/*"],

      "@watchdog/caps": ["./packages/caps/src/index.ts"],
      "@watchdog/caps/capabilities.gen.json": [
        "./packages/caps/capabilities.gen.json"
      ],
      "@watchdog/caps/sdk": ["./packages/caps/src/sdk/index.ts"],
      "@watchdog/caps/*": ["./packages/caps/src/*"],

      "@watchdog/cli/*": ["./apps/cli/src/*"],

      "@watchdog/client": ["./packages/client/src/index.ts"],
      "@watchdog/client/*": ["./packages/client/src/*"],

      "@watchdog/server/core/blob": [
        "./packages/server/core/src/infra/blob.ts"
      ],
      "@watchdog/server/core/job-display": [
        "./packages/server/core/src/display/job-display.ts"
      ],
      "@watchdog/server/core/proposal-display": [
        "./packages/server/core/src/display/proposal-display.ts"
      ],
      "@watchdog/server/core/*": ["./packages/server/core/src/*"],

      "@watchdog/server/db": ["./packages/server/db/src/index.ts"],
      "@watchdog/server/db/*": ["./packages/server/db/src/*"],

      "@watchdog/server/env/*": ["./packages/server/env/src/*"],

      "@watchdog/server/log": ["./packages/server/log/src/index.ts"],
      "@watchdog/server/log/*": ["./packages/server/log/src/*"],

      "@watchdog/domain/policy": ["./packages/domain/policy/src/index.ts"],
      "@watchdog/domain/policy/*": ["./packages/domain/policy/src/*"],

      "@watchdog/domain/schemas/*": ["./packages/domain/schemas/src/*"],

      "@watchdog/server/test-db": ["./packages/server/test-db/src/index.ts"],

      "@watchdog/domain/test-kit": ["./packages/domain/test-kit/src/index.ts"],
      "@watchdog/domain/test-kit/http": [
        "./packages/domain/test-kit/src/http/mock-server.ts"
      ],
      "@watchdog/domain/test-kit/*": ["./packages/domain/test-kit/src/*"],

      "@watchdog/caps/tools/*": ["./packages/caps/tools/src/*"],

      "@watchdog/ui/*": ["./packages/ui/src/*"]
    }
  }
}
