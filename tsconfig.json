{
  "extends": "./tsconfig.base.json",
  "files": [],
  // Type context for linting root config files by path (the pre-commit hook); never emitted.
  "include": ["*.config.ts"],
  "compilerOptions": {
    "paths": {
      "@/*": ["./apps/web/src/*"],

      "@watchdog/ai": ["./packages/ai/src/index.ts"],
      "@watchdog/ai/*": ["./packages/ai/src/*"],

      "@watchdog/api": ["./packages/api/src/index.ts"],
      "@watchdog/api/*": ["./packages/api/src/*"],

      "@watchdog/auth/*": ["./packages/auth/src/*"],

      "@watchdog/caps": ["./packages/caps/src/index.ts"],
      "@watchdog/caps/capabilities.gen.json": [
        "./packages/caps/capabilities.gen.json"
      ],
      "@watchdog/caps/sdk": ["./packages/caps/src/sdk/index.ts"],
      "@watchdog/caps/*": ["./packages/caps/src/*"],

      "@watchdog/cli/*": ["./apps/cli/src/*"],

      "@watchdog/client": ["./packages/client/src/index.ts"],
      "@watchdog/client/*": ["./packages/client/src/*"],

      "@watchdog/core/blob": ["./packages/core/src/infra/blob.ts"],
      "@watchdog/core/job-display": [
        "./packages/core/src/display/job-display.ts"
      ],
      "@watchdog/core/proposal-display": [
        "./packages/core/src/display/proposal-display.ts"
      ],
      "@watchdog/core/*": ["./packages/core/src/*"],

      "@watchdog/db": ["./packages/db/src/index.ts"],
      "@watchdog/db/*": ["./packages/db/src/*"],

      "@watchdog/env/*": ["./packages/env/src/*"],

      "@watchdog/log": ["./packages/log/src/index.ts"],
      "@watchdog/log/*": ["./packages/log/src/*"],

      "@watchdog/domain/policy": ["./packages/domain/policy/src/index.ts"],
      "@watchdog/domain/policy/*": ["./packages/domain/policy/src/*"],

      "@watchdog/domain/schemas/*": ["./packages/domain/schemas/src/*"],

      "@watchdog/test-db": ["./packages/test-db/src/index.ts"],

      "@watchdog/domain/test-kit": ["./packages/domain/test-kit/src/index.ts"],
      "@watchdog/domain/test-kit/http": [
        "./packages/domain/test-kit/src/http/mock-server.ts"
      ],
      "@watchdog/domain/test-kit/*": ["./packages/domain/test-kit/src/*"],

      "@watchdog/tools/*": ["./packages/tools/src/*"],

      "@watchdog/ui/*": ["./packages/ui/src/*"]
    }
  }
}
