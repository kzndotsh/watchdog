# ============================================================
# Watchdog production env (docker-compose.prod.yml)
#   cp env.production.example .env.production
# Every value marked MUST CHANGE is blank on purpose: the stack refuses to start
# without it. This file holds secrets: never commit .env.production.
# Walkthrough: docs/how-to/self-host.md
# ============================================================

# ---- Postgres (the compose stack builds both connection URLs from these) ----
# Two roles. POSTGRES_USER owns the schema: migrations, the first-admin command and vault key
# rotation run as it. The app (web and worker) runs as watchdog_app, which can read and write rows
# but cannot alter or drop tables, create objects or change the audit tables.
POSTGRES_DB=watchdog
POSTGRES_USER=watchdog
# MUST CHANGE. Letters and digits only: it is placed in a connection URL.
#   openssl rand -hex 24
POSTGRES_PASSWORD=
# MUST CHANGE. The password of watchdog_app, created with it when the database volume is first
# made. Letters and digits only, and not the owner's password:
#   openssl rand -hex 24
POSTGRES_APP_PASSWORD=
# DATABASE_URL (watchdog_app) and DATABASE_URL_MIGRATE (the owner, for web's migrations) are built
# by docker-compose.prod.yml from the values above: do not set them.
# DATABASE_URL=
# DATABASE_URL_MIGRATE=

# ---- Object storage (SeaweedFS in the stack) ----
# MUST CHANGE (both). Any strings; the store starts with this identity.
#   openssl rand -hex 12   /   openssl rand -hex 24
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=watchdog-evidence
S3_REGION=us-east-1
# Default http://s3:8333 (inside the compose network): how web and worker reach the store.
# S3_ENDPOINT=http://s3:8333
# Browsers upload Evidence straight to the store with presigned requests, so a public install
# sets the public HTTPS URL its reverse proxy serves the store at (docs/how-to/self-host.md,
# "Reverse proxy and TLS"). Unset presigns against S3_ENDPOINT, which only works on one host.
# S3_PUBLIC_URL=

# ---- Better Auth ----
# MUST CHANGE. At least 32 characters:   openssl rand -base64 32
BETTER_AUTH_SECRET=
# MUST CHANGE. The exact URL users type in the browser, with scheme and no trailing slash.
# Also the CORS origin allowed on the storage bucket.
BETTER_AUTH_URL=
# Registration stays closed. Create the first admin with the bootstrap command
# (docs/how-to/self-host.md, "First admin"), not by opening signup.
BETTER_AUTH_ALLOW_SIGNUP=0
# Extra origins that may call the app, comma-separated.
# BETTER_AUTH_TRUSTED_ORIGINS=

# ---- Vault (Cap credentials at rest) ----
# MUST CHANGE. Back it up: without it, stored Cap credentials cannot be read.
#   openssl rand -base64 32
WD_MASTER_VAULT_KEY=

# ---- Optional ----
# Case Export folder inside the containers (the stack mounts the export_data volume there).
# WD_EXPORT_DIR=/data/export
# Largest Case export zip (MB of Evidence) streamed straight to the download; a bigger one runs as a Job (default 100).
# WD_EXPORT_INLINE_MAX_MB=100
# Hours the download link of a large Case export works (default 24).
# WD_EXPORT_LINK_TTL_HOURS=24
# Evidence files and entities a Case export reads at once (default 4).
# WD_EXPORT_CONCURRENCY=4
# Jobs a worker runs at once per lane: quick lookups, heavy processing (parsing Evidence, large exports), actions (defaults 4, 2, 2). Their sum may not exceed 8: the worker refuses to start otherwise.
# WD_WORKER_QUICK_CONCURRENCY=4
# WD_WORKER_HEAVY_CONCURRENCY=2
# WD_WORKER_ACT_CONCURRENCY=2
# Most log lines (default 1000) and kilobytes (default 128) one Job keeps, and how often a running Job's new lines are saved (ms, default 1000).
# WD_JOB_LOG_MAX_LINES=1000
# WD_JOB_LOG_MAX_KB=128
# WD_JOB_LOG_FLUSH_MS=1000
# Days a deleted Case stays restorable before the worker purges it for good (default 30).
# WD_CASE_RETENTION_DAYS=30
# Enable the breach Caps (HIBP, Hudson Rock, DeHashed, Snusbase). Off by default; on makes you responsible for a lawful basis and the providers' terms.
# WD_ENABLE_BREACH_CAPS=0
# Route every Cap request through one http(s) proxy (docs/reference/platform/caps-boundary.md).
# WD_EGRESS_PROXY=
# Send errors to a Sentry-compatible tracker (Sentry, GlitchTip, Bugsink): its DSN. Unset sends nothing.
# WD_ERROR_REPORTING_DSN=
# Build label attached to error reports and exported logs (a version or commit SHA).
# WD_RELEASE=
# Export logs over OTLP/HTTP (OpenTelemetry Collector, Datadog Agent, Grafana, Honeycomb, SigNoz): the receiver base URL. Unset sends nothing.
# WD_OTLP_ENDPOINT=
# Headers for it, name=value pairs separated by commas (usually the API key).
# WD_OTLP_HEADERS=
# Extra resource attributes for exported logs, key=value pairs separated by commas.
# WD_OTLP_RESOURCE_ATTRIBUTES=
# The images set NODE_ENV=production; leave it.
# NODE_ENV=production

# ---- Optional SMTP for invitation mail ----
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=watchdog@example.com

# ---- Migrations ----
# The web container applies pending migrations on start (under a Postgres advisory lock).
# 1 skips them (run them by hand). The worker container never migrates.
# WD_SKIP_MIGRATIONS=0

# ---- Compose ----
# Host bind of the web port. Loopback by default: publish it through a TLS reverse proxy.
# WEB_BIND=127.0.0.1
# WEB_PORT=3000
# S3_PUBLISH_PORT=9100
# Image names; set to published tags when release images exist (issue #310).
# WATCHDOG_WEB_IMAGE=watchdog-web:local
# WATCHDOG_WORKER_IMAGE=watchdog-worker:local
