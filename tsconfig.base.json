{
  // Shared compiler options for every package, app and test project. Each tsconfig.json
  // extends this file; keep only genuine differences (jsx, lib, paths, rootDir, include,
  // exclude) in the package. tsconfig.test.json extends its package's tsconfig.json.
  // Enforced by scripts/__tests__/tsconfig-base.gate.test.ts.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "types": ["node"],
    "plugins": [{ "name": "@effect/tsgo" }]
  }
}
