{
  "search.exclude": {
    "repos/**": true,
    ".claude/worktrees/**": true
  },
  "files.watcherExclude": {
    "repos/**": true,
    "**/.claude/worktrees/**": true
  },
  "files.exclude": {
    "repos/**": false,
    ".claude/worktrees": true
  },
  "git.repositoryScanIgnoredFolders": ["node_modules", ".claude/worktrees"],
  "js/ts.preferences.autoImportFileExcludePatterns": [
    "**/repos/**",
    "**/.claude/worktrees/**"
  ],
  "js/ts.tsserver.watchOptions": {
    "excludeDirectories": ["**/node_modules", "**/.claude/worktrees"]
  },
  "nixEnvSelector.nixFile": "${workspaceFolder}/flake.nix",
  "nixEnvSelector.useFlakes": true,
  "nixEnvSelector.flakeShell": "default"
}
